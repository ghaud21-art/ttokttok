# Supabase 프로젝트 설정 (Project Settings → API 에서 확인)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Gemini API 키 (Google AI Studio에서 발급) — 서버(Vercel Functions)에서만 사용, 절대 VITE_ 접두사를 붙이지 않는다
GEMINI_API_KEY=your-gemini-api-key

# Supabase Service Role 키 (Project Settings → API → service_role) — 관리자 기능(가입자
# 목록/정지/삭제)과 AI 사용량 제한에 사용. RLS를 완전히 우회하는 매우 민감한 키이므로
# 절대 VITE_ 접두사를 붙이지 말고, 서버(Vercel Functions)에서만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 카카오 도서검색 REST API 키 (developers.kakao.com → 애플리케이션 추가 → 요약 정보의
# "REST API 키") — 책 등록 화면의 자동완성 검색에 사용. 서버(Vercel Functions)에서만
# 쓰므로 절대 VITE_ 접두사를 붙이지 않는다.
KAKAO_REST_API_KEY=your-kakao-rest-api-key
